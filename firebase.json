{
  "hosting": {
    "site": "gioia-app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/sendWhatsAppNotification",
        "function": {
          "functionId": "sendWhatsAppNotification",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/sendAdminNotification",
        "function": {
          "functionId": "sendAdminNotification",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
